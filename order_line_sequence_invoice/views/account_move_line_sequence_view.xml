<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit account.move form view -->
    <record id="view_move_form_inherit_sequence" model="ir.ui.view">
        <field name="name">account.move.form.inherit.line.sequence</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- Add sequence number before product field -->
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='product_id']" position="before">
                <field name="invoice_sequence_number" readonly="1" string="No" />
            </xpath>
        </field>
    </record>
</odoo>

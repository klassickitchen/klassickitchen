<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--    To show the amount in words in invoice report-->
    <template id="invoice_report_view_amount_in_words"
              inherit_id="account.report_invoice_document">
        <!-- Sits in the free space to the left of the Gross Total / Net Total block.
             mt-5 mirrors #right-elements so the two line up vertically in the PDF. -->
        <xpath expr="//div[@id='right-elements']" position="after">
            <div name="amount_in_words"
                 t-attf-class="#{'mt-5' if report_type == 'pdf' else ''}"
                 style="font-size:11px; padding: 2px; page-break-inside: avoid; break-inside: avoid;">
                <span>
                    <strong>Amount in Words (Total) :</strong>
                </span>
                <span t-field="o.number_to_words"/>
                <div t-if="o.number_to_words_ar">
                    <strong>المبلغ بالكلمات (الإجمالي):</strong>
                    <span t-field="o.number_to_words_ar"/>
                </div>
            </div>
        </xpath>

        <xpath expr="//p[@name='payment_communication']" position="replace"/>
    </template>
    <!--To show the amount in words on purchase report-->
    <template id="purchase_report_view_amount_in_words"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[hasclass('justify-content-end')]" position="after">
            <div style="font-size:11px; padding: 2px;">
                <span>
                    <strong>Amount in Words (Total) :</strong>
                </span>
                <span t-field="o.number_to_words"/>
            </div>
        </xpath>
    </template>
    <!--To show the amount in words to the sales report-->
    <template id="sale_report_view_amount_in_words"
              inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@class='clearfix']" position="after">
            <div style="font-size:11px; padding: 2px;">
                <span>
                    <strong>Amount in Words (Total) :</strong>
                </span>
                <span t-field="doc.number_to_words"/>
            </div>
        </xpath>
    </template>
</odoo>

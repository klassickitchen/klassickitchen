<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_product_form_view_inherit_kitchenkraft" model="ir.ui.view">
        <field name="name">product.product.form.inherit.kitchenkraft</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[1]" position="after">
                <page string="Barcode">
                    <field name="alternative_barcode_ids">

                        <list editable="bottom">
                            <field name="barcode" />
                            <field name="uom_id" />
                            <field name="price" />
                            <field name="company_id" />
                            <field name="arabic_price_alt" />
                            <button name="action_open_label_layout2"
                                string="Print Label"
                                type="object"
                                icon="fa-print">
                            </button>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="product_template_search_view_inherit_barcode" model="ir.ui.view">
        <field name="name">product.template.search.inherit.barcode</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="barcode" string="Alternative Barcode"
                    filter_domain="[('product_variant_ids.alternative_barcode_ids.barcode', 'ilike', self)]" />
            </xpath>
        </field>
    </record>

    <record id="product_product_search_form_view_inherit_barcode" model="ir.ui.view">
        <field name="name">product.product.search.inherit.barcode</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name'][1]" position="after">
                <field name="barcode" string="Alternative Barcode"
                    filter_domain="[('alternative_barcode_ids.barcode', 'ilike', self)]" />
            </xpath>
        </field>
    </record>

</odoo>
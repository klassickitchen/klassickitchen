<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template id="report_simple_label_dymo_inherit_company"
            inherit_id="product.report_simple_label_dymo">
            <xpath expr="//div[@class='o_label_sheet o_label_dymo']" position="replace">
                <t t-if="barcode or alternative_barcode_ids">
                    <div class="o_label_sheet o_label_dymo" t-att-style="padding_page">
                        <!-- Full label content: one full-width column, no negative offsets.
                             `padding:0` on every div overrides the .o_label_sheet div rule
                             (padding: 2px 4px) which otherwise shrinks the usable width. -->
                        <div
                            style="padding:0; margin:0; width:100%; text-align:center; line-height:1.1; font-family: 'Oswald', sans-serif !important; font-weight: 500 !important;">

                            <!-- Company name -->
                            <div
                                style="padding:0; width:100%; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; white-space:nowrap; overflow:hidden;">
                                <t t-esc="env.company.name" />
                            </div>

                            <!-- Product name (English), full width, max 2 lines -->
                            <div
                                style="padding:0; width:100%; font-size:9px; font-weight:600; text-transform:uppercase; letter-spacing:0.3px; word-break:break-word; white-space:normal; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                                <t t-esc="product.name" />
                            </div>

                            <!-- Product name (Arabic), full width -->
                            <t t-if="product.arabic_name">
                                <div
                                    style="padding:0; width:100%; font-size:9px; font-weight:600; direction:rtl; white-space:nowrap; overflow:hidden;">
                                    <t t-esc="product.arabic_name" />
                                </div>
                            </t>

                            <t t-if="barcode">
                                <!-- Barcode image, spanning the full label width -->
                                <div t-out="barcode"
                                    style="padding:0; margin:0; width:100%; text-align:center;"
                                    t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': 'width:100%; height:7mm; display:block;'}" />

                                <!-- Barcode number (left) & internal reference (right) -->
                                <div style="padding:0; width:100%; font-size:8px; font-weight:600;">
                                    <span
                                        style="display:inline-block; width:64%; text-align:left; letter-spacing:0.5px;"
                                        t-out="barcode" />
                                    <span
                                        style="display:inline-block; width:34%; text-align:right; letter-spacing:0.5px;"
                                        t-out="product.default_code or ''" />
                                </div>

                                <!-- Price (left) & Arabic price (right) -->
                                <div style="padding:0; width:100%; font-size:12px; font-weight:700;">
                                    <t t-if="len(barcode_and_qty) == 2">
                                        <span style="display:inline-block; width:56%; text-align:left;">QR:<t
                                                t-esc="'{:,.2f}'.format(product.lst_price)" />
                                        </span>
                                        <span
                                            style="display:inline-block; width:42%; text-align:right; direction:rtl;">
                                            <t t-esc="product.arabic_price or ''" />
                                        </span>
                                    </t>
                                    <t t-if="len(barcode_and_qty) &gt; 2">
                                        <span style="display:inline-block; width:56%; text-align:left;">QR:<t
                                                t-esc="'{:,.2f}'.format(float(barcode_and_qty[2]))" />
                                        </span>
                                        <span
                                            style="display:inline-block; width:42%; text-align:right; direction:rtl;">
                                            <t t-foreach="product.alternative_barcode_ids"
                                                t-as="alt_barcode">
                                                <t
                                                    t-if="alt_barcode.barcode == barcode_and_qty[0] and alt_barcode.arabic_price_alt">
                                                    <t t-esc="alt_barcode.arabic_price_alt" />
                                                </t>
                                            </t>
                                        </span>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </div>

                </t>
            </xpath>
        </template>

    </data>
</odoo>

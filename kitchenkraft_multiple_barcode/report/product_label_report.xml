<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template id="report_simple_label_dymo_inherit_company" inherit_id="product.report_simple_label_dymo">
            <xpath expr="//div[@class='o_label_sheet o_label_dymo']" position="replace">
                <t t-if="barcode or alternative_barcode_ids">
                    <div class="o_label_sheet o_label_dymo" t-att-style="padding_page">
                        <!-- Entire label content here -->
                        <div style="text-align:center; font-weight:bold; font-size:6px; margin-bottom:2px;">
                            <span t-esc="env.company.name"/>
                            <br/>
                            <span t-esc="product.name"
                                  style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:100%;"/>
                            <br/>
                            <span t-esc="product.arabic_name"
                                  style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:100%;"/>
                        </div>
                        <t t-if="barcode">
                            <!-- Barcode Image -->
                            <div t-out="barcode"
                                 style="padding:0; margin:auto;text-align:center;"
                                 t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': 'width:50px; height:20px;'}"/>

                            <!-- Barcode number & product code -->
                            <div style="text-align:center; font-size:4px; margin-top:1px; line-height:1.2;">
                                <span t-out="barcode" style="margin-left:33px;"/>
                                <t t-if="product.default_code">
                                    <span style="float:center; font-size:4px;margin-right:35px;"
                                          t-out="product.default_code"/>
                                </t>
                                <div style="text-align:center;font-weight:bold; font-size:10px; line-height:1.3;">
                                    <t t-if="len(barcode_and_qty) == 2">
                                        <span style="margin-left: 20px;">QR
                                            <t t-esc="product.lst_price"/>
                                        </span>
                                        <t t-if="product.arabic_price">
                                            <span style="margin-left:1px;">
                                                <t t-esc="product.arabic_price"/>
                                            </span>
                                        </t>
                                    </t>
                                    <t t-if="len(barcode_and_qty) > 2">
                                        <span>QR
                                            <t t-esc="barcode_and_qty[2]"/>
                                        </span>
                                        <t t-foreach="product.alternative_barcode_ids" t-as="alt_barcode">
                                            <t t-if="alt_barcode.barcode == barcode_and_qty[0] and alt_barcode.arabic_price_alt">
                                                <span style="margin-left:10px;">
                                                    <t t-esc="alt_barcode.arabic_price_alt"/>
                                                </span>
                                            </t>
                                        </t>
                                    </t>
                                </div>
                            </div>

                            <!-- Price block -->

                        </t>

                        <!-- Price -->
                        <!--            <div class="o_label_left_column" style="text-align:center;margin-top:0.7em;font-weight:bold;">-->
                        <!--                <t t-if="len(barcode_and_qty) == 2">-->
                        <!--                    <span>QR <t t-esc="product.lst_price"/>-->
                        <!--                        <span style="margin-left:10px;"><t t-esc="product.arabic_price"/></span>-->
                        <!--                    </span>-->
                        <!--                </t>-->
                        <!--                <t t-if="len(barcode_and_qty) > 2">-->
                        <!--                    <span>QR <t t-esc="barcode_and_qty[2]"/>-->
                        <!--                        <span style="margin-left:10px;"><t t-esc="product.arabic_price_alt"/></span>-->
                        <!--                    </span>-->
                        <!--                </t>-->
                        <!--            </div>-->
                    </div>

                </t>
            </xpath>
        </template>

    </data>
</odoo>




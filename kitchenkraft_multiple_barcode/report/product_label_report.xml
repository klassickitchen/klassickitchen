<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template id="report_simple_label_dymo_inherit_company" inherit_id="product.report_simple_label_dymo">
            <xpath expr="//div[@class='o_label_sheet o_label_dymo']" position="replace">
    <t t-if="barcode or alternative_barcode_ids">
        <div class="o_label_sheet o_label_dymo" t-att-style="padding_page">
            <!-- Entire label content here -->
            <div style="text-align:center; font-weight:bold; font-size:9px; margin-bottom:2px;">
                <span t-esc="env.company.name"/><br/>
                <span t-esc="product.name"/><br/>
                <span t-esc="product.arabic_name"/>
            </div>
            <t t-if="barcode">
    <!-- Barcode Image -->
    <div t-out="barcode"
         style="padding:0; margin:auto;"
         t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': barcode_size}"/>

    <!-- Barcode number & product code -->
    <div style="text-align:left; font-size:8px; margin-top:2px; line-height:1.2;">
        <span t-out="barcode"/>
        <t t-if="product.default_code">
            <span style="float:right; font-size:8px;" t-out="product.default_code"/>
        </t>
    </div>

    <!-- Price block -->
    <div style="text-align:center; margin-top:4px; font-weight:bold; font-size:10px; line-height:1.3;">
        <t t-if="len(barcode_and_qty) == 2">
            <span>QR <t t-esc="product.lst_price"/></span>
            <t t-if="product.arabic_price">
                <span style="margin-left:10px;"><t t-esc="product.arabic_price"/></span>
            </t>
        </t>
        <t t-if="len(barcode_and_qty) > 2">
            <span>QR <t t-esc="barcode_and_qty[2]"/></span>
            <t t-if="product.arabic_price_alt">
                <span style="margin-left:10px;"><t t-esc="product.arabic_price_alt"/></span>
            </t>
        </t>
    </div>
</t>

            <!-- Price -->
<!--            <div class="o_label_left_column" style="text-align:center;margin-top:0.7em;font-weight:bold;">-->

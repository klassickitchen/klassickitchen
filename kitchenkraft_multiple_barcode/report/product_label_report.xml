<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template id="report_simple_label_dymo_inherit_company" inherit_id="product.report_simple_label_dymo">
            <xpath expr="//div[@class='o_label_sheet o_label_dymo']" position="replace">
                <t t-if="barcode or alternative_barcode_ids">
                    <div class="o_label_sheet o_label_dymo" t-att-style="padding_page">
                        <!-- Entire label content here -->
                        <div style="width:100%; font-family: 'Oswald', sans-serif !important; text-align:center; font-size:6px; font-weight: 400 !important; position: relative; bottom:12px; right:2px;">

                            <div style="display:inline-block; width:55%; margin-bottom:10px; line-height:1.2;">

                                <span style="display:block; font-size:6px; font-weight:500; letter-spacing:1px;">
                                    <t t-esc="env.company.name"/>
                                </span>

                                <span style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; font-size:5px; font-weight:500; margin-left:4px; word-break:break-word; white-space:normal; line-height:1.3; letter-spacing:1px;">
                                    <t t-esc="product.name"/>
                                </span>

                                <span style="display:block; font-size:5px; font-weight:500; letter-spacing:1px;">
                                    <t t-esc="product.arabic_name"/>
                                </span>
                            </div>
                        </div>

                        <div style="padding:0; font-family: 'Oswald', sans-serif !important; margin:auto; position: relative; bottom:28px; right:5px; font-weight: 500 !important;">


                            <t t-if="barcode">
                                <!-- Product Code(internal reference) -->
                                <t t-if="product.default_code">
                                    <div style="text-align:center; font-size:6px; font-weight:500;">
                                        <span t-out="product.default_code"/>
                                    </div>
                                </t>
                                <!-- Barcode Image -->
                                <div t-out="barcode"
                                     style="padding:0; margin:auto;text-align:center; position: relative; bottom:10px;"
                                     t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': 'width:67px; height:13px;'}"/>

                                <!-- Barcode number & product code -->
                                <div style="text-align:center; font-size:4px; line-height:0.1; position: relative; bottom:9px;">
                                    <!-- Barcode Code -->
                                    <span t-out="barcode" style="margin-left:7px; font-size:6px; font-weight:500;"/>

                                    <div style="text-align:center;font-weight:500; font-size:8px; line-height:1.8;">
                                        <t t-if="len(barcode_and_qty) == 2">
                                            <span>QR:
                                                <t t-esc="'{:,.2f}'.format(product.lst_price)"/>
                                            </span>
                                            <t t-if="product.arabic_price">
                                                <span style="margin-left:1px;">
                                                    <t t-esc="product.arabic_price"/>
                                                </span>
                                            </t>
                                        </t>
                                        <t t-if="len(barcode_and_qty) > 2">
                                            <span>QR:
                                                <t t-esc="'{:,.2f}'.format(float(barcode_and_qty[2]))"/>
                                            </span>
                                            <t t-foreach="product.alternative_barcode_ids" t-as="alt_barcode">
                                                <t t-if="alt_barcode.barcode == barcode_and_qty[0] and alt_barcode.arabic_price_alt">
                                                    <span style="margin-left:10px;">
                                                        <t t-esc="alt_barcode.arabic_price_alt"/>
                                                    </span>
                                                </t>
                                            </t>
                                        </t>
                                    </div>
                                </div>

                                <!-- Price block -->

                            </t>
                        </div>

                        <!-- Price -->
                        <!--            <div class="o_label_left_column" style="text-align:center;margin-top:0.7em;font-weight:bold;">-->
                        <!--                <t t-if="len(barcode_and_qty) == 2">-->
                        <!--                    <span>QR <t t-esc="product.lst_price"/>-->
                        <!--                        <span style="margin-left:10px;"><t t-esc="product.arabic_price"/></span>-->
                        <!--                    </span>-->
                        <!--                </t>-->
                        <!--                <t t-if="len(barcode_and_qty) > 2">-->
                        <!--                    <span>QR <t t-esc="barcode_and_qty[2]"/>-->
                        <!--                        <span style="margin-left:10px;"><t t-esc="product.arabic_price_alt"/></span>-->
                        <!--                    </span>-->
                        <!--                </t>-->
                        <!--            </div>-->
                    </div>

                </t>
            </xpath>
        </template>

    </data>
</odoo>

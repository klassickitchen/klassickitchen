<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template id="report_simple_label_dymo_inherit_company"
            inherit_id="product.report_simple_label_dymo">
            <xpath expr="//div[@class='o_label_sheet o_label_dymo']" position="replace">
                <t t-if="barcode or alternative_barcode_ids">

                    <!-- The label wizard passes either a product.template or a
                         product.product, so resolve both records explicitly. -->
                    <t t-set="is_tmpl" t-value="product._name == 'product.template'" />
                    <t t-set="kk_tmpl" t-value="product if is_tmpl else product.product_tmpl_id" />
                    <t t-set="kk_var" t-value="product.product_variant_id if is_tmpl else product" />

                    <!-- Arabic name is the product.product column edited on the Product
                         Variants form. product.template declares a separate column of the
                         same name, kept as a fallback. Guards keep a missing field safe. -->
                    <t t-set="kk_ar_name"
                        t-value="(kk_var.arabic_name if 'arabic_name' in kk_var._fields else False)
                                 or (kk_tmpl.arabic_name if 'arabic_name' in kk_tmpl._fields else False)
                                 or ''" />

                    <!-- Arabic price is stored on product.product only. -->
                    <t t-set="kk_ar_price"
                        t-value="(kk_var.arabic_price if 'arabic_price' in kk_var._fields else '') or ''" />

                    <div class="o_label_sheet o_label_dymo" t-att-style="padding_page">

                        <style>
                            /* Kill every border/background/outline the base label
                               stylesheet or report layout may draw. */
                            .o_label_sheet.o_label_dymo,
                            .o_label_sheet.o_label_dymo * {
                                border: 0 !important;
                                outline: 0 !important;
                                box-shadow: none !important;
                                background: transparent !important;
                            }
                            /* .o_label_sheet div { padding: 2px 4px } steals width.
                               Only padding is reset here - margins are set per row below. */
                            .o_label_sheet.o_label_dymo div,
                            .o_label_sheet.o_label_dymo span {
                                padding: 0 !important;
                            }
                            /* Top-aligned so there is no gap above the company name.
                               table-cell because wkhtmltopdf's WebKit does not do
                               flexbox reliably. */
                            .kk_wrap {
                                display: table;
                                width: 100%;
                                height: 27mm;
                            }
                            .kk_label {
                                display: table-cell;
                                vertical-align: top;
                                width: 100%;
                                text-align: center;
                                line-height: 1.15;
                                font-family: 'Oswald', Arial, sans-serif;
                                font-weight: 500;
                            }
                            .kk_label .kk_co {
                                font-size: 9px;
                                font-weight: 700;
                                text-transform: uppercase;
                                letter-spacing: 0.5px;
                                white-space: nowrap;
                                overflow: hidden;
                            }
                            /* Gap 0: between the company name and the English name */
                            .kk_label .kk_en {
                                font-size: 8px;
                                font-weight: 400;
                                margin-top: 2px;
                                text-transform: uppercase;
                                letter-spacing: 0.3px;
                                word-break: break-word;
                                white-space: normal;
                                display: -webkit-box;
                                -webkit-line-clamp: 2;
                                -webkit-box-orient: vertical;
                                overflow: hidden;
                            }
                            /* Oswald has no Arabic glyphs - force a font that does */
                            .kk_label .kk_ar {
                                font-family: 'DejaVu Sans', 'Noto Naskh Arabic',
                                             'Traditional Arabic', Arial, sans-serif;
                                direction: rtl;
                            }
                            /* Gap 1: between the English name and the Arabic name */
                            .kk_label .kk_arname {
                                font-size: 8.5px;
                                font-weight: 400;
                                line-height: 1.25;
                                margin-top: 3px;
                                white-space: nowrap;
                                overflow: hidden;
                            }
                            /* Gap 2: between the Arabic name and the barcode */
                            .kk_label .kk_bc {
                                margin-top: 3px;
                            }
                            /* Forced barcode size - beats the inline img_style either way */
                            .kk_label .kk_bc img {
                                width: 70% !important;
                                height: 6.5mm !important;
                                display: block;
                                margin: 0 auto;
                            }
                            /* Gap 3: between the barcode and the barcode number */
                            .kk_label .kk_code {
                                font-size: 9px;
                                font-weight: 400;
                                letter-spacing: 0.5px;
                                margin-top: 3px;
                            }
                            /* Gap 4: between the number/reference row and the price row */
                            .kk_label .kk_price {
                                font-size: 13px;
                                font-weight: 600;
                                margin-top: 3px;
                            }
                        </style>

                        <div class="kk_wrap">
                        <div class="kk_label">

                            <!-- Company name -->
                            <div class="kk_co">
                                <t t-out="env.company.name" />
                            </div>

                            <!-- Product name (English), full width, max 2 lines -->
                            <div class="kk_en">
                                <t t-out="product.name" />
                            </div>

                            <!-- Product name (Arabic), full width -->
                            <t t-if="kk_ar_name">
                                <div class="kk_arname kk_ar">
                                    <t t-out="kk_ar_name" />
                                </div>
                            </t>

                            <t t-if="barcode">
                                <!-- Barcode: 70% of the label width, centred -->
                                <div t-out="barcode" class="kk_bc"
                                    t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': 'width:70%; height:6.5mm; display:block; margin:0 auto;'}" />

                                <!-- Barcode number (left) + internal reference (right) -->
                                <div class="kk_code">
                                    <span style="display:inline-block; width:64%; text-align:left;"
                                        t-out="barcode" />
                                    <span style="display:inline-block; width:34%; text-align:right;"
                                        t-out="product.default_code or ''" />
                                </div>

                                <!-- Price (left) + Arabic price (right) -->
                                <div class="kk_price">
                                    <t t-if="len(barcode_and_qty) == 2">
                                        <span style="display:inline-block; width:56%; text-align:left;">QR:<t
                                                t-out="'{:,.2f}'.format(product.lst_price)" />
                                        </span>
                                        <span class="kk_ar"
                                            style="display:inline-block; width:42%; text-align:right;"
                                            t-out="kk_ar_price" />
                                    </t>
                                    <t t-if="len(barcode_and_qty) &gt; 2">
                                        <span style="display:inline-block; width:56%; text-align:left;">QR:<t
                                                t-out="'{:,.2f}'.format(float(barcode_and_qty[2]))" />
                                        </span>
                                        <span class="kk_ar"
                                            style="display:inline-block; width:42%; text-align:right;">
                                            <t t-foreach="kk_var.alternative_barcode_ids"
                                                t-as="alt_barcode">
                                                <t
                                                    t-if="alt_barcode.barcode == barcode_and_qty[0] and alt_barcode.arabic_price_alt">
                                                    <t t-out="alt_barcode.arabic_price_alt" />
                                                </t>
                                            </t>
                                        </span>
                                    </t>
                                </div>
                            </t>
                        </div>
                        </div>
                    </div>

                </t>
            </xpath>
        </template>

    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_report_footer" model="ir.ui.view">
        <field name="name">res.users.form.inherit.report.footer</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Report Footer" name="report_footer_tab">
                    <div class="text-muted mb-2">
                        Replaces the company footer text on "Print PDF" invoices sold by this user (POS or Sales).
                        Leave empty to use the company footer.
                    </div>
                    <field name="report_footer" widget="html"
                           placeholder="Add showroom footer HTML or insert banner image here..."/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

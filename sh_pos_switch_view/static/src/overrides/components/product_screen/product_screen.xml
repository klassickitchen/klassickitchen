<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="sh_pos_switch_view.ShProductCard"> 
        <tr t-on-click="() => this.addProductToOrder(props.product)" t-att-data-product-id="props.productId"
            t-attf-aria-labelledby="article_product_{{props.productId}}" class="1563">
            <t t-if="pos.config.sh_display_product_image">
                <td>
                    <t t-if="props.imageUrl">
                        <t t-if="pos.config.sh_product_image_size == 'small_size'">
                            <img t-att-src="props.imageUrl" t-att-alt="props.name" class="small_size_image"/>
                        </t>
                        <t t-if="pos.config.sh_product_image_size == 'medium_size'">
                            <img t-att-src="props.imageUrl" t-att-alt="props.name" class="medium_size_image"/>
                        </t>
                        <t t-if="pos.config.sh_product_image_size == 'large_size'">
                            <img t-att-src="props.imageUrl" t-att-alt="props.name" class="large_size_image"/>
                        </t>
                    </t>
                    <t t-else="">
                        -
                    </t>
                </td>
            </t>
            <t t-if="pos.config.sh_display_product_name">
                <td>
                    <t t-esc="props.name"/>
                </td>
            </t>
            <t t-if="pos.config.sh_display_product_code">
                <td>
                    <t t-if="props.product.default_code and props.product.product_variant_count == 1">
                        <t t-esc="props.product.default_code"/>
                    </t>
                    <t t-else="">
                        -
                    </t>
                </td>
            </t>
            <t t-if="pos.config.sh_display_product_type">
                <td>
                    <t t-if="props.product.type == 'consu'">
                        Goods
                    </t>
                    <t t-if="props.product.type == 'combo'">
                        Combo
                    </t>
                    <t t-if="props.product.type == 'service'">
                        Service
                    </t>
                </td>
            </t>
            <t t-if="pos.config.sh_display_product_onhand">
                <td>
                    <t t-if="props.product.product_variant_count == 1">
                        <t t-if="props.product.qty_available > 0">
                            <t t-esc="props.product.qty_available"/>
                        </t>
                        <t t-else="">
                            0
                        </t>
                    </t>
                    <t t-else="">
                        -
                    </t>
                    
                </td>
            </t>
            <t t-if="pos.config.sh_display_product_forecasted">
                <td>
                    <t t-if="props.product.product_variant_count == 1">
                        <t t-if="props.product.virtual_available > 0">
                            <t t-esc="props.product.virtual_available"/>
                        </t>
                        <t t-else="">
                            0
                        </t>
                    </t>
                    <t t-else="">
                        -
                    </t>
                </td>
            </t>
            <t t-if="pos.config.sh_display_product_uom">
                <td>
                    <t t-esc="props.product.uom_id.name"/>
                </td>
            </t>
            <t t-if="pos.config.sh_display_product_price">
                <td>
                    <t t-if="props.product.product_price">
                        <t t-esc="props.product.product_price"/>
                    </t>
                </td>
            </t>
        </tr>
    </t>


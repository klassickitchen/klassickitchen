<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_remove_data" model="ir.ui.view">
        <field name="name">Remove Data</field>
        <field name="model">res.config.settings</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Data Cleaner Settings" class="oe_form_configuration">
                <sheet>
                    <div class="o_settings_container_custom" style="padding: 0px 100px 0px 100px; margin: auto 0 auto 0;" name="data-clean">
                        <div class="alert alert-danger mb-4">
                            <h3 class="text-danger">⚠️ Warning: Irreversible Deletion</h3>
                            <p>Data is deleted directly from the database using SQL queries. <strong>Once deleted, it cannot be recovered.</strong> Proceed with caution.</p>
                        </div>

                        <!-- Delete All -->
                        <div class="card shadow-sm mb-4 p-3">
                            <h4 class="text-primary mb-2">🗑️ General Cleanup</h4>
                            <button string="Delete All Transactions Except Master Data" type="object" name="remove_all"
                                    confirm="Please confirm to delete all transactional data?" class="btn btn-danger"/>
                        </div>
                        <div class="models_buttons" style="padding: 0px 300px 0px 300px;">
                            <!-- Sales -->
                            <div class="card shadow-sm mb-4 p-3">
                                <h4 class="text-primary mb-2">🧾 Sales</h4>
                                <button string="Delete All Sales Order" type="object" name="remove_sales"
                                        confirm="Please confirm to delete all Sales Orders?" class="btn btn-outline-danger"/>
                            </div>

                            <!-- POS -->
                            <div class="card shadow-sm mb-4 p-3">
                                <h4 class="text-primary mb-2">🧾 POS</h4>
                                <button string="Delete All POS Order" type="object" name="remove_pos"
                                        confirm="Please confirm to delete all POS Orders?" class="btn btn-outline-danger"/>
                            </div>

                            <!-- Purchase -->
                            <div class="card shadow-sm mb-4 p-3">
                                <h4 class="text-primary mb-2">🧾 Purchase</h4>
                                <button string="Delete All Purchase Order and Requisition" type="object" name="remove_purchase"
                                        confirm="Please confirm to delete all Purchase Orders and Requisitions?" class="btn btn-outline-danger"/>
                            </div>

                            <!-- Expense -->
                            <div class="card shadow-sm mb-4 p-3">
                                <h4 class="text-primary mb-2">💸 Expenses</h4>
                                <button string="Delete All Expense and Sheet" type="object" name="remove_expense"
                                        confirm="Please confirm to delete all Expenses?" class="btn btn-outline-danger"/>
                            </div>

                            <!-- MRP -->
                            <div class="card shadow-sm mb-4 p-3">
                                <h4 class="text-primary mb-2">🏭 Manufacturing (MRP)</h4>
                                <button string="Delete All Manufacturing Order" type="object" name="remove_mrp"
                                        confirm="Please confirm to delete all Manufacturing Orders?" class="btn btn-outline-danger"/>
                                <button string="Delete All BOM" type="object" name="remove_mrp_bom"
                                        confirm="Please confirm to delete all BOMs?" class="btn btn-outline-danger ml-2"/>
                            </div>

                            <!-- Inventory -->
                            <div class="card shadow-sm mb-4 p-3">
                                <h4 class="text-primary mb-2">📦 Inventory</h4>
                                <button string="Delete All Move/Picking/Package/Lot" type="object" name="remove_inventory"
                                        confirm="Please confirm to delete all inventory data?" class="btn btn-outline-danger"/>
                            </div>

                            <!-- Accounting -->
                            <div class="card shadow-sm mb-4 p-3">
                                <h4 class="text-primary mb-2">📊 Accounting</h4>
                                <button string="Delete All Voucher/Invoice/Bill" type="object" name="remove_account"
                                        confirm="Please confirm to delete all Accounting data?" class="btn btn-outline-danger"/>
                                <button string="Clean and Reset Account Chart" type="object" name="remove_account_chart"
                                        confirm="Are you sure you want to reset Account Chart?" class="btn btn-outline-warning ml-2"/>
                            </div>

                            <!-- Project -->
                            <div class="card shadow-sm mb-4 p-3">
                                <h4 class="text-primary mb-2">📁 Project</h4>
                                <button string="Delete All Project/Task/Forecast" type="object" name="remove_project"
                                        confirm="Please confirm to delete all project data?" class="btn btn-outline-danger"/>
                            </div>

                            <!-- Quality -->
                            <div class="card shadow-sm mb-4 p-3">
                                <h4 class="text-primary mb-2">✅ Quality</h4>
                                <button string="Delete All Quality" type="object" name="remove_quality"
                                        confirm="Please confirm to delete all quality records?" class="btn btn-outline-danger"/>
                                <button string="Delete All Quality Setting" type="object" name="remove_quality_setting"
                                        confirm="Please confirm to delete all quality settings?" class="btn btn-outline-danger ml-2"/>
                            </div>

                            <!-- Website &amp;amp; Blog -->
                            <div class="card shadow-sm mb-4 p-3">
                                <h4 class="text-primary mb-2">🌐 Website &amp; Blog</h4>
                                <button string="Delete All Website/Blog" type="object" name="remove_website"
                                        confirm="Please confirm to delete all website/blog content?" class="btn btn-outline-danger"/>
                            </div>

                            <!-- Base Models -->
                            <div class="card shadow-sm mb-4 p-3">
                                <h4 class="text-primary mb-2">⚙️ Base Models</h4>
                                <button string="Delete All Product" type="object" name="remove_product"
                                        confirm="Please confirm to delete all Products?" class="btn btn-outline-danger"/>
                                <button string="Delete All Product Attribute" type="object" name="remove_product_attribute"
                                        confirm="Please confirm to delete all Product Attributes?" class="btn btn-outline-danger ml-2"/>
                                <button string="Delete All Message" type="object" name="remove_message"
                                        confirm="Please confirm to delete all Messages?" class="btn btn-outline-danger ml-2"/>
                                <button string="Reset Category And Location Complete Name" type="object"
                                        name="reset_cat_loc_name" class="btn btn-outline-warning ml-2"/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_remove_data" model="ir.actions.act_window">
        <field name="name">Remove Data</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_remove_data"/>
        <field name="target">inline</field>
    </record>

    <menuitem
        id="menu_remove_data"
        name="Remove Data"
        action="action_remove_data"
        parent="base.menu_administration"
        sequence="1"
        groups="base.group_system"/>

</odoo>

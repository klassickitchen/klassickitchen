<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('more-btn')]" position="before">
            <button class="btn btn-light btn-lg lh-lg flex-shrink-0"
                    t-on-click="onClickFixedDiscount">
                Fixed Discount
            </button>

        </xpath>
    </t>

</templates>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="empire_custom_external_layout_standard" inherit_id="web.external_layout_standard">

        <!-- Custom Header -->
        <xpath expr="//div[contains(@t-attf-class, 'header o_company_#{company.id}_layout')]" position="replace">

            <t t-if="company.report_header_image">
                <div class="header" style="text-align: center; margin: 0; padding: 0;">
                    <img t-att-src="image_data_uri(company.report_header_image)"
                         alt="Header Image" style="width: 100%; height: auto;"/>
                </div>
            </t>
            <t t-else="">
                <div class="row mb8">
                    <div class="col-4">
                        <img t-if="company.logo" class="o_company_logo_big"
                             t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                    </div>
                    <div class="col-8 text-end mb4">
                        <div name="company_address" class="float-end mb4">
                            <ul class="list-unstyled" name="company_address_list">
                                <li t-if="company.is_company_details_empty">
                                    <span t-field="company.partner_id"
                                          t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/>
                                </li>
                                <li t-else="">
                                    <span t-field="company.company_details"/>
                                </li>
                                <li t-if="not forced_vat"/>
                                <li t-else="">
                                    <t t-esc="company.country_id.vat_label or 'Tax ID'"/>:
                                    <span t-esc="forced_vat"/>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </t>

        </xpath>

        <!-- Custom Footer -->
        <xpath expr="//div[contains(@t-attf-class, 'footer o_company_#{company.id}_layout')]" position="replace">

            <t t-if="company.report_footer_image">
                <div class="footer" style="text-align: center; margin: 0; padding: 0;">
                    <img t-att-src="image_data_uri(company.report_footer_image)"
                         alt="Footer Image" style="width: 100%; height: auto;"/>
                </div>
            </t>
            <t t-else="">
                <div class="o_footer_content row border-top pt-2">
                    <div class="col-8">
                        <span t-field="company.report_footer"/>
                    </div>
                    <div class="col-4 text-end">
                        <strong t-if="company.report_header" t-field="company.report_header"
                                class="o_company_tagline"/>
                        <span t-if="report_type == 'pdf' and display_name_in_footer"
                              class="text-muted" t-out="str(o.name) + ', '"/>
                        <span t-if="report_type == 'pdf'" class="text-muted">
                            Page
                            <span class="page"/>
                            /
                            <span class="topage"/>
                        </span>
                    </div>
                </div>
            </t>
        </xpath>

    </template>
</odoo>

<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_view_order_form" model="ir.ui.view">
        <field name="name">sale.order.line.form.inherited.product_image_added</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
<!--                <field name="use_custom_description"/>-->
                <field name="show_product_image"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='product_template_id']" position="after">
<!--                <field name="custom_description" optional="show" column_invisible="not parent.use_custom_description"/>-->
                <field name="sale_order_line_product_image" widget="image" column_invisible="not parent.show_product_image"/>
            </xpath>
            <!-- Gross Total and Discount above the totals, as on the quotation PDF and the
                 invoice form. Both are computed live, so they follow line edits. -->
            <!-- sale_total is a flex column, so a plain <field> stacks its label above its
                 value. Keep each label and value on one right-aligned row, with the same label
                 classes as the Untaxed Amount / Total rows of the tax totals widget below. -->
            <xpath expr="//group[@name='sale_total']/field[@name='tax_totals']" position="before">
                <div class="d-flex justify-content-end align-items-baseline" colspan="2">
                    <label for="gross_total" class="o_form_label o_tax_total_label"/>
                    <field name="gross_total" nolabel="1" class="w-auto"/>
                </div>
                <div class="d-flex justify-content-end align-items-baseline" colspan="2"
                     invisible="not amount_discount">
                    <label for="amount_discount" class="o_form_label o_tax_total_label"/>
                    <field name="amount_discount" nolabel="1" class="w-auto"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
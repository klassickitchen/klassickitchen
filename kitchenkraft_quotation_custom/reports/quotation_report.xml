<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
    <template id="inherit_sale_order_quotation_template" inherit_id="sale.report_saleorder_document">
        <xpath expr="//span[@t-field='line.name']" position="replace">
            <t t-if="line.product_id and line.product_id.product_tmpl_id.is_discount">
                <span t-field="line.product_id.name"/>
            </t>
            <t t-else="">
                <span t-field="line.name"/>
            </t>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="after">
            <th t-if="doc.show_product_image" name="th_image" class="text-start">Product Image</th>
        </xpath>
        <xpath expr="//tbody[@class='sale_tbody']//td[@name='td_name']" position="after">
            <td t-if="doc.show_product_image" name="td_image"
                class="text-center"
                style="vertical-align: middle; width: 90px; white-space: nowrap;">
                <div style="display: flex; justify-content: center; align-items: center; height: 100%;">
                    <img t-if="line.sale_order_line_product_image"
                         t-att-src="image_data_uri(line.sale_order_line_product_image)"
                         style="max-height: 80px; max-width: 80px; width: auto; height: auto; object-fit: contain;"/>
                </div>
            </td>
        </xpath>

        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_slno" class="text-center">Sl No:</th>
        </xpath>
        <xpath expr="//tbody[@class='sale_tbody']//td[@name='td_name']" position="before">
            <td name="td_slno" class="text-center" style="vertical-align: middle;">
                <t t-if="not sl_no">
                    <t t-set="sl_no" t-value="1"/>
                </t>
                <t t-else="">
                    <t t-set="sl_no" t-value="sl_no + 1"/>
                </t>
                <span t-esc="sl_no"/>
            </td>
        </xpath>

        <xpath expr="//th[@name='th_taxes']" position="replace"/>
        <xpath expr="//tbody[@class='sale_tbody']//td[@name='td_taxes']" position="replace"/>

        <!-- Discount is shown once in the totals block (as on the invoice), not per line:
             drop the Disc.% column and print each line before discount. -->
        <xpath expr="//t[@t-set='display_discount']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>
        <xpath expr="//td[@name='td_subtotal']/span[@t-field='line.price_subtotal']" position="attributes">
            <attribute name="t-field">line.amount_without_discount</attribute>
        </xpath>
        <xpath expr="//t[@t-set='current_subtotal'][@t-value='current_subtotal + line.price_subtotal']"
               position="attributes">
            <attribute name="t-value">current_subtotal + line.amount_without_discount</attribute>
        </xpath>

    </template>

    <!-- Totals block: Gross Total, Discount, taxes, Net Total, as on the invoice. -->
    <template id="sale_document_tax_totals_discount" inherit_id="sale.document_tax_totals">
        <xpath expr="//t[@t-as='subtotal']" position="before">
            <t t-set="show_gross_discount" t-value="doc and doc._name == 'sale.order'"/>
        </xpath>
        <xpath expr="//tr[@class='o_subtotal']" position="attributes">
            <attribute name="t-if">not show_gross_discount</attribute>
        </xpath>
        <xpath expr="//tr[@class='o_subtotal']" position="before">
            <t t-if="show_gross_discount and subtotal_first">
                <tr>
                    <td style="font-size: 15px !important;">Gross Total</td>
                    <td class="text-end" style="font-size: 15px !important;">
                        <span t-out="doc.gross_total"
                              t-options='{"widget": "monetary", "display_currency": currency}'/>
                    </td>
                </tr>
                <tr t-if="not currency.is_zero(doc.amount_discount)">
                    <td style="font-size: 15px !important;">Discount</td>
                    <td class="text-end" style="font-size: 15px !important;">
                        <span t-out="doc.amount_discount"
                              t-options='{"widget": "monetary", "display_currency": currency}'/>
                    </td>
                </tr>
            </t>
        </xpath>
        <xpath expr="//tr[@class='o_total']/td[1]" position="attributes">
            <attribute name="t-if">not show_gross_discount</attribute>
        </xpath>
        <xpath expr="//tr[@class='o_total']/td[1]" position="before">
            <td t-if="show_gross_discount">
                <strong style="font-size: 15px !important;">Net Total</strong>
            </td>
        </xpath>
    </template>
    </data>
</odoo>
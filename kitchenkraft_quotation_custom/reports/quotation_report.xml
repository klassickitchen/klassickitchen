<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
    <template id="inherit_sale_order_quotation_template" inherit_id="sale.report_saleorder_document">
        <xpath expr="//span[@t-field='line.name']" position="replace">
            <t t-if="line.product_id and line.product_id.product_tmpl_id.is_discount">
                <span t-field="line.product_id.name"/>
            </t>
            <t t-else="">
                <span t-field="line.name"/>
            </t>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="after">
            <th t-if="doc.show_product_image" name="th_image" class="text-start">Product Image</th>
        </xpath>
        <xpath expr="//tbody[@class='sale_tbody']//td[@name='td_name']" position="after">
            <td t-if="doc.show_product_image" name="td_image"
                class="text-center"
                style="vertical-align: middle; width: 90px; white-space: nowrap;">
                <div style="display: flex; justify-content: center; align-items: center; height: 100%;">
                    <img t-if="line.sale_order_line_product_image"
                         t-att-src="image_data_uri(line.sale_order_line_product_image)"
                         style="max-height: 80px; max-width: 80px; width: auto; height: auto; object-fit: contain;"/>
                </div>
            </td>
        </xpath>
    </template>
    </data>
</odoo>
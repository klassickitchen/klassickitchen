<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- STRIPED LAYOUT -->
    <template id="custom_external_layout_striped" inherit_id="web.external_layout_striped">
        <xpath expr="//div[contains(@t-attf-class, 'header')]" position="attributes">
            <attribute name="t-if">not hide_report_footer and not wo_header_and_footer</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer')]" position="attributes">
            <attribute name="t-if">not hide_report_footer and not wo_header_and_footer</attribute>
        </xpath>
    </template>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_invoice_a5">
            <t t-call="account.report_invoice">
                <t t-set="print_with_payments" t-value="True"/>
            </t>
        </template>
        <template id="report_invoice_document_inherit_customer_line" inherit_id="account.report_invoice_document">
            <xpath expr="//div[@name='address_same_as_shipping']//address" position="replace"/>
            <xpath expr="//t[@t-set='layout_document_title']" position="inside">
                <span style="margin-left:200px;">
                    <t t-esc="o.partner_id.name" style="text-align:right;"/></span>
            </xpath>

        <!-- Target the layout title block that contains the invoice number -->


    </template>
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_invoice_a5">
            <t t-call="account.report_invoice">
                <t t-set="print_with_payments" t-value="True"/>
            </t>
        </template>

        <template id="report_invoice_document_inherit_customer_line"
                  inherit_id="account.report_invoice_document">

            <xpath expr="//t[@t-set='layout_document_title']" position="replace">
                <t t-set="layout_document_title" style="margin-top: 50px;">
                    <span t-if="not proforma"></span>
                    <span t-else="">PROFORMA</span>
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'"
                          style="font-size:22px; color: black;">Invoice
                    </span>
                    <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'"
                          style="font-size:22px; color: black;">Draft
                        Invoice
                    </span>
                    <span t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'"
                          style="font-size:22px; color: black;">
                        Cancelled Invoice
                    </span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'posted'"
                          style="font-size:22px; color: black;">Credit
                        Note
                    </span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'draft'"
                          style="font-size:22px; color: black;">Draft
                        Credit Note
                    </span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'cancel'"
                          style="font-size:22px; color: black;">Cancelled
                        Credit Note
                    </span>
                    <span t-elif="o.move_type == 'in_refund'" style="font-size:22px; color: black;">Vendor Credit Note</span>
                    <span t-elif="o.move_type == 'in_invoice'" style="font-size:22px; color: black;">Vendor Bill</span>
                    <span t-if="o.name and o.name != '/'" t-field="o.name" style="font-size:22px; color: black;">INV/2023/0001</span>
                    <span style="margin-left:450px; font-size: 22px; color: black;">
                        <t t-esc="o.partner_id.name" style="text-align:right;"/>
                    </span>
                </t>
            </xpath>

            <xpath expr="//div[@name='address_same_as_shipping']//address" position="replace"/>
            <xpath expr="//td[@name='account_invoice_line_name']" position="replace"/>
            <xpath expr="//td[@name='td_quantity']" position="before">
                <td name="account_invoice_line_name">
                    <span t-if="line.name" t-field="line.name" style="font-size: 19px;" t-options="{'widget': 'text'}"/>
                    <br/>
                    <span t-if="line.product_id.arabic_name" style="font-size: 18px;"
                          t-esc="line.product_id.arabic_name"/>
                </td>
            </xpath>
            <!-- increase table width -->
            <xpath expr="//table[@name='invoice_line_table']" position="attributes">
                <attribute name="style">width: 103%; position: relative; right: 1%;</attribute>
            </xpath>

            <!--reduce line spacing for Paid and Amount Due -->
            <xpath expr="//t[@t-if='print_with_payments']" position="replace">
                <t t-if="print_with_payments">
                    <t t-if="o.payment_state != 'invoicing_legacy'">
                        <t t-set="payments_vals"
                           t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                        <t t-foreach="payments_vals" t-as="payment_vals">
                            <tr t-if="payment_vals['is_exchange'] == 0" style="line-height: 0.8;">
                                <td style="padding: 2px 0;">
                                    <i class="oe_form_field text-end oe_payment_label" style="font-size: 11px;">
                                        <t t-if="payment_vals['is_refund']">Reversed on</t>
                                        <t t-else="">Paid on</t>
                                        <t t-out="payment_vals['date']" t-options='{"widget": "date"}'/>
                                    </i>
                                </td>
                                <td class="text-end" style="padding: 2px 0;">
                                    <span t-out="payment_vals['amount']"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                        <t t-if="len(payments_vals) > 0">
                            <tr class="fw-bold" style="line-height: 0.8;">
                                <td style="padding: 2px 0;">Amount Due</td>
                                <td class="text-end" style="padding: 2px 0;">
                                    <span t-field="o.amount_residual"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </t>
            </xpath>
        </template>


        <template id="document_tax_totals_template_inherit" inherit_id="account.document_tax_totals_template">
            <!-- reduce line spacing between subtotal and tax rows -->
            <xpath expr="//tr[@class='o_subtotal']" position="attributes">
                <attribute name="style">line-height: 0.8; padding: 0; margin: 0;</attribute>
            </xpath>

            <xpath expr="//tr[@class='o_total']" position="attributes">
                <attribute name="style">line-height: 0.8; color: black; padding: 0; margin: 0;</attribute>
            </xpath>

            <xpath expr="//tr[@class='o_taxes']" position="attributes">
                <attribute name="style">line-height: 0.8; padding: 0; margin: 0;</attribute>
            </xpath>

            <xpath expr="//tr[@class='o_subtotal']" position="after">
                <tr t-if="sum(line.price_subtotal for line in o.invoice_line_ids if 'disc' in (line.name or '').lower())"
                    style="line-height: 0.8;">
                    <td>
                        <strong>Discount</strong>
                    </td>
                    <td class="text-end">
                        <strong>
                            <t t-esc="sum(-line.price_subtotal for line in o.invoice_line_ids if 'disc' in (line.name or '').lower())"/>
                            <t t-esc="o.currency_id.symbol"/>
                        </strong>
                    </td>
                </tr>
            </xpath>

        </template>


    </data>
</odoo>
    <record id="action_print_pdf_a5" model="ir.actions.report">
        <field name="name">Print PDF A5</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">invoice_sequence_custom.report_invoice_with_payments_twice_a5</field>
        <field name="report_file">invoice_sequence_custom.report_invoice_with_payments_twice_a5</field>
        <field name="paperformat_id" ref="invoice_sequence_custom.paperformat_a5" />
        <field name="is_invoice_report">True</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="binding_type">report</field>
        <field name="domain" eval="[('move_type', '!=', 'entry'), ('is_pos_invoice', '=', True)]" />
    </record>


<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="paperformat_a5" model="report.paperformat">
        <field name="name">A5</field>
        <field name="default">False</field>
        <field name="format">A5</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">26</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
    </record>

    <record id="account_invoices_a4" model="ir.actions.report">
        <field name="name">Invoice A4</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">invoice_sequence_custom.report_invoice_a5</field>
        <field name="report_file">invoice_sequence_custom.report_invoice_a5</field>
        <field name="is_invoice_report">True</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="attachment"/>
        <field name="binding_model_id"
               eval="False"/>  <!-- removes the action from the Print menu (forced False value for update) -->
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice')),
 (4, ref('account.group_account_readonly'))]"/>
    </record>

    <record id="account_invoices_a5" model="ir.actions.report">
        <field name="name">Invoice A5</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account.report_invoice_with_payments</field>
        <field name="report_file">account.report_invoice_with_payments</field>
        <field name="paperformat_id" ref="invoice_sequence_custom.paperformat_a5"/>
        <field name="is_invoice_report">True</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="attachment"/>
        <field name="binding_model_id"
               eval="False"/>  <!-- removes the action from the Print menu (forced False value for update) -->
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice')),
 (4, ref('account.group_account_readonly'))]"/>
    </record>

</odoo>

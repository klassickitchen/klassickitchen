<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="paperformat_a5" model="report.paperformat">
        <field name="name">A5</field>
        <field name="default">False</field>
        <field name="format">A5</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">23</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_spacing">65</field>
    </record>

    <record id="paperformat_dot_matrix_a4" model="report.paperformat">
        <field name="name">Dot Matrix A4</field>
        <field name="default">False</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">27</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_spacing">65</field>
    </record>

    <record id="paperformat_a4_custom" model="report.paperformat">
        <field name="name">A4 Custom</field>
        <field name="default">False</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_spacing">35</field>
    </record>

    <record id="account_invoices_a4" model="ir.actions.report">
        <field name="name">Invoice A4</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">invoice_sequence_custom.report_invoice_with_payments_twice_a4</field>
        <field name="report_file">invoice_sequence_custom.report_invoice_with_payments_twice_a4</field>
        <field name="is_invoice_report">True</field>
        <field name="paperformat_id" ref="invoice_sequence_custom.paperformat_a4_custom" />
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="attachment" />
        <field name="binding_model_id"
            eval="False" />  <!-- removes the action from the Print menu (forced False value for
        update) -->
        <field name="groups_id"
            eval="[(4, ref('account.group_account_invoice')),
 (4, ref('account.group_account_readonly'))]" />
    </record>

    <record id="account_invoices_a4_wo_header_footer" model="ir.actions.report">
        <field name="name">Print A4 w/o Header and Footer</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">invoice_sequence_custom.report_invoice_with_payments_twice_a4_wo_header_and_footer</field>
        <field name="report_file">invoice_sequence_custom.report_invoice_with_payments_twice_a4_wo_header_and_footer</field>
        <field name="is_invoice_report">True</field>
        <field name="paperformat_id" ref="invoice_sequence_custom.paperformat_a4_custom" />
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="attachment" />
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="binding_type">report</field>
    </record>


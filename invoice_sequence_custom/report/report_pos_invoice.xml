    <!-- only one no customer or office-->
    <template id="report_invoice_with_payments_twice_a5">
        <t t-set="hide_report_footer" t-value="True" />
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="lang" t-value="doc.partner_id.lang" />
                <t t-set="o" t-value="doc" />
                <t t-call="account.report_invoice_document" t-lang="lang" />
            </t>
        </t>
    </template>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_rounding_absorption" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.rounding.absorption</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='smallest_coinage_currency']" position="after">
                <setting id="pos_rounding_absorption"
                         string="Absorb Small Cash Rounding"
                         help="Print a cash rounding difference below the threshold as part of the discount instead of on its own Rounding line. The journal entry is unchanged.">
                    <field name="pos_rounding_absorb"/>
                    <div class="content-group mt16" invisible="not pos_rounding_absorb">
                        <div class="row">
                            <label for="pos_rounding_absorb_threshold" string="Threshold"
                                   class="col-lg-4 o_light_label"/>
                            <field name="pos_rounding_absorb_threshold"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>

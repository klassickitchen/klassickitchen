<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="account_invoice_source" model="ir.ui.view">
        <field name="name">account.move.source</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="is_pos_invoice" invisible="1"/>
            </xpath>

            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="payment_type" widget="radio"/>
                <field name="description_display" widget="radio"/>
            </xpath>

            <xpath expr="//list//field[@name='price_subtotal']" position="after">
                <field name="amount_without_discount"/>
            </xpath>

            <xpath expr="//list//field[@name='price_subtotal']" position="replace"/>
            <xpath expr="//list//field[@name='discount']" position="replace"/>

            <xpath expr="//group[@class='oe_subtotal_footer']//field[@name='tax_totals']" position="before">
                <field name="gross_total" colspan="2"/>
                <field name="amount_discount" colspan="2"/>
            </xpath>


            <!--            <xpath expr="//button[@name='action_print_pdf']" position="after">-->
            <!--                <button name="action_print_pdf_with_header_footer"-->
            <!--                        string="PDF with Header and Footer"-->
            <!--                        type="object"-->
            <!--                        class="oe_highlight"-->
            <!--                        invisible="state != 'posted'"/>-->
            <!--            </xpath>-->
        </field>
    </record>
</odoo>
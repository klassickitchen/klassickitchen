<odoo>
    <record id="view_sale_order_form_inherit_po_number" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.po.number</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="client_order_ref" string="PO Number"/>
            </xpath>

            <xpath expr="//page[@name='other_information']//group[@name='sales_person']//field[@name='client_order_ref']"
                   position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>


        </field>
    </record>
</odoo>

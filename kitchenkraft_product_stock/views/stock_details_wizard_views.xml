<odoo>
    <record id="view_stock_details_wizard_form" model="ir.ui.view">
        <field name="name">stock.details.wizard.form</field>
        <field name="model">stock.details.wizard</field>
        <field name="arch" type="xml">
            <form string="Stock Details">
                <group>
                    <field name="product_id"/>
                </group>
                <notebook>
                    <page string="Stock Details">
                        <field name="stock_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="company_id"/>
                                <field name="quantity"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

<odoo>
    <record id="view_intercompany_stock_wizard_form" model="ir.ui.view">
        <field name="name">intercompany.stock.wizard.form</field>
        <field name="model">intercompany.stock.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Intercompany Purchase Order" edit="1">
                <group>
                    <field name="sale_order_id" readonly="1"/>
                </group>
                <separator string="Products to Purchase"/>
                <field name="order_line_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="selected"/>
                        <field name="product_id"/>
                        <field name="company_id" required="1"/>
                        <field name="qty_available" readonly="1"/>
                        <field name="free_quantity" readonly="1"/>
                        <field name="quantity"/>
                        <field name="price_unit"/>
                        <field name="amount" readonly="1" sum="Total"/>
                    </list>
                </field>
                <footer>
                    <button string="Create and Process PO(s)" type="object" class="btn-primary" name="create_intercompany_purchase_order_confirm" data-hotkey="q"/>
                    <button string="Create PO" type="object" class="btn-primary" name="create_intercompany_purchase_order" />
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
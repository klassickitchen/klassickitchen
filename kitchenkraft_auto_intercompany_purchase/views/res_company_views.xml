<odoo>
    <record id="view_company_form_inherit_intercompany_margin" model="ir.ui.view">
        <field name="name">res.company.form.inherit.intercompany.margin</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website']" position="after">
                <field name="intercompany_margin_pct"/>
            </xpath>
        </field>
    </record>
</odoo>

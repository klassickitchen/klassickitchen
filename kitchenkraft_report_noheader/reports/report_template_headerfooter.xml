<odoo>

    <template id="external_layout_striped_no_header_footer" inherit_id="web.external_layout_striped">

        <xpath expr="//div[contains(@t-attf-class, 'o_company_#{company.id}_layout header')]" position="attributes">
            <attribute name="t-if">not (o and o._name == 'account.move')</attribute>
        </xpath>


        <xpath expr="//div[contains(@t-attf-class, 'footer o_company_#{company.id}_layout')]" position="attributes">
            <attribute name="t-if">not (o and o._name == 'account.move')</attribute>
        </xpath>


    </template>
    <template id="custom_external_layout_boxed" inherit_id="web.external_layout_boxed">

    <xpath expr="//div[@t-attf-class='header o_company_#{company.id}_layout']" position="replace">
        <div t-if="o and o._name not in ['account.move']"
             t-attf-class="header o_company_#{company.id}_layout">
            <div class="row mb8">
                <div class="col-4">
                    <img t-if="company.logo" class="o_company_logo_big" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                </div>
                <div class="col-8 text-end mb4">
                    <div name="company_address" class="float-end mb4">
                        <ul class="list-unstyled" name="company_address_list">
                            <li t-if="company.is_company_details_empty">
                                <span t-field="company.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/>
                            </li>
                            <li t-else="">
                                <span t-field="company.company_details" class="text-nowrap"/>
                            </li>
                            <li t-if="not forced_vat"/>
                            <li t-else="">
                                <t t-esc="company.country_id.vat_label or 'Tax ID'"/>:
                                <span t-esc="forced_vat"/>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </xpath>


   <xpath expr="//div[contains(@t-attf-class, 'footer o_company_#{company.id}_layout')]" position="attributes">
            <attribute name="t-if">not (o and o._name == 'account.move')</attribute>
        </xpath>
</template>
    <template id="external_layout_bold_no_header_footer" inherit_id="web.external_layout_bold">

        <xpath expr="//div[contains(@t-attf-class, 'header o_company_#{company.id}_layout')]" position="attributes">
            <attribute name="t-if">not (o and o._name == 'account.move')</attribute>
        </xpath>

        <!-- Footer: show only if NOT invoice -->
        <xpath expr="//div[contains(@t-attf-class, 'footer o_company_#{company.id}_layout')]" position="attributes">
            <attribute name="t-if">not (o and o._name == 'account.move')</attribute>
        </xpath>


    </template>


    <template id="custom_external_layout_bubble" inherit_id="web.external_layout_bubble">
        <xpath expr="//div[contains(@class, 'd-flex justify-content-between')]" position="attributes">
            <attribute name="t-if">not (o and o._name == 'account.move')</attribute>

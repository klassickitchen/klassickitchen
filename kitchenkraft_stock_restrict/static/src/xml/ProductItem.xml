<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="point_of_sale.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-information-tag')]"
               position="after">
            <div t-attf-class="qty-badge #{props.product.qty_available &lt;= 0 ? 'not-available' : ''}">
                <t t-esc="props.product.qty_available"/>
            </div>
        </xpath>
    </t>
</templates>
